      ]
    },
    {
      "name": "Assistant",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/assistant/chat",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Am I eligible to donate?\"\n}" }
          }
        },
        { "name": "Suggest Banks", "request": { "method": "GET", "url": "{{baseUrl}}/api/assistant/suggest-banks?bloodGroup=O%2B" } }
      ]
    },
    {
      "name": "Content",
      "item": [
        { "name": "Announcements", "request": { "method": "GET", "url": "{{baseUrl}}/api/content/announcements" } },
        { "name": "Health Tips", "request": { "method": "GET", "url": "{{baseUrl}}/api/content/health-tips" } },
        { "name": "FAQs", "request": { "method": "GET", "url": "{{baseUrl}}/api/content/faqs" } },
        { "name": "Home Stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/content/home-stats" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Stats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/stats" } },
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/dashboard" } },
        { "name": "Blood Group Distribution", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/blood-group-distribution" } },
        { "name": "Monthly Donations", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/monthly-donations" } },
        { "name": "Hospitals", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/hospitals" } },
        { "name": "Blood Banks", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/admin/blood-banks" } },
        {
          "name": "Verify Hospital",
